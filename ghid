#!/usr/bin/env bash
#
# ghid — GitHub IDentity manager for hosts with multiple GH accounts.
#
# Solves the multi-identity SSH problem: prevents accidental pushes /
# fetches under the wrong account, locks repos to specific identities,
# verifies the identity actually matches what GitHub sees, and rewrites
# `git@github.com:owner/repo.git` URLs to identity-aliased SSH URLs.
#
# Assumes ~/.ssh/config has `Host github-<identity>` aliases — one per
# identity, each pointing at a dedicated SSH key. Run `ghid doctor` to
# check.
#
# Subcommands:
#   ghid list                  — list configured identities + verify each
#   ghid doctor                — sanity-check ~/.ssh/config + keys
#   ghid current               — show current repo's bound identity
#   ghid init <identity>       — `git init` here under <identity>'s per-repo
#                                user.name/email + pre-locked (never touches
#                                global git config). Reads email from
#                                ~/.config/ghidbar/identities.conf
#                                (or --email <addr>).
#   ghid switch <identity>     — rewrite this repo's remotes to use <identity>
#   ghid lock <identity>       — bind this repo to <identity> via pre-push hook
#   ghid unlock                — remove the binding
#   ghid guard {install|status|uninstall}
#                              — machine-wide backstop: a global git template
#                                pre-commit hook so EVERY new `git init`/`clone`
#                                refuses commits until an explicit local
#                                identity is chosen (no silent global leaks)
#   ghid verify [<identity>]   — confirm ssh -T resolves to expected user
#   ghid whoami                — quick: who would `git push` from this repo be?
#   ghid new <identity>        — create a new key + SSH alias for
#                                <identity>; also records the identity's
#                                email (prompted, or via --email <addr>) at
#                                ~/.config/ghidbar/identities.conf so future
#                                `ghid init` calls auto-bind it.
#
# Why it exists: GitHub identifies SSH-authenticated users by key
# fingerprint. The `User <name>` field in ~/.ssh/config is cosmetic and
# does NOT change which GitHub account a push lands under. Multi-
# identity hosts where every block uses `Host github.com` will silently
# auth EVERY operation as whichever identity comes first in the file.
# ghid forces explicit identity-aliased URLs (e.g.
# git@github-myalias:owner/repo.git) and provides the safety nets so
# the wrong identity can't slip through.

set -euo pipefail

SSH_CONFIG="${SSH_CONFIG:-$HOME/.ssh/config}"
IDENTITY_PREFIX="github-"

# ---- helpers ---- #

c_red()    { printf "\033[31m%s\033[0m" "$*"; }
c_grn()    { printf "\033[32m%s\033[0m" "$*"; }
c_yel()    { printf "\033[33m%s\033[0m" "$*"; }
c_dim()    { printf "\033[2m%s\033[0m" "$*"; }
c_bold()   { printf "\033[1m%s\033[0m" "$*"; }
ok()       { echo "  $(c_grn ✓) $*"; }
warn()     { echo "  $(c_yel ⚠) $*"; }
err()      { echo "  $(c_red ✗) $*" >&2; }
die()      { err "$*"; exit 1; }

in_git_repo() { git rev-parse --git-dir >/dev/null 2>&1; }

# Per-identity email is stored at:
#   $HOME/.config/ghidbar/identities.conf
# Format: one identity per line as `<identity>=<email>`. Comments
# start with `#` and are preserved on update.
IDENTITIES_CONF="$HOME/.config/ghidbar/identities.conf"

# Read the email for <identity> from IDENTITIES_CONF, or empty.
_identity_email() {
    local id="$1"
    [[ -f "$IDENTITIES_CONF" ]] || return 0
    grep -E "^${id}=" "$IDENTITIES_CONF" 2>/dev/null | head -1 | sed "s/^${id}=//"
}

# Set <identity>=<email> in IDENTITIES_CONF (replace if exists, append
# if not). Touches the parent dir and the file as needed.
_identity_email_set() {
    local id="$1" email="$2"
    mkdir -p "$(dirname "$IDENTITIES_CONF")"
    if [[ -f "$IDENTITIES_CONF" ]] && grep -qE "^${id}=" "$IDENTITIES_CONF"; then
        # Replace in place. Use a tmpfile rather than sed -i for
        # portability across BSD / GNU sed.
        local tmp; tmp=$(mktemp)
        awk -v id="$id" -v new="${id}=${email}" '
            $0 ~ "^" id "=" { print new; next }
            { print }
        ' "$IDENTITIES_CONF" > "$tmp"
        mv "$tmp" "$IDENTITIES_CONF"
    else
        [[ -f "$IDENTITIES_CONF" ]] || cat > "$IDENTITIES_CONF" <<'HDR'
# ghidbar identity → email map.
# Auto-managed by `ghid new` (and `ghid init --email <addr>`).
# One entry per identity: <identity>=<email>
HDR
        printf "%s=%s\n" "$id" "$email" >> "$IDENTITIES_CONF"
    fi
}

# Push the current repo path into ghidbar's state file so the
# menu-bar app's 5 s timer picks it up and refreshes the title /
# lock icon. Best-effort; silently skipped if ghidbar isn't
# installed.
_update_ghidbar_state() {
    local state="$HOME/.config/ghidbar/state.json"
    [[ -d "$(dirname "$state")" ]] || return 0
    local repo
    repo="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
    [[ -n "$repo" ]] || return 0
    printf '{\n  "repo": "%s"\n}\n' "$repo" > "$state" 2>/dev/null || true
}

# Parse ~/.ssh/config and emit one line per `Host github-*` alias:
#   github-myalias|/Users/me/.ssh/myalias-GitHub
list_aliases() {
    [[ -f "$SSH_CONFIG" ]] || return 0
    awk -v pfx="$IDENTITY_PREFIX" '
        tolower($1) == "host" {
            cur_host = ""
            for (i = 2; i <= NF; ++i) {
                if (index($i, pfx) == 1) { cur_host = $i; break }
            }
            cur_key = ""
            next
        }
        cur_host != "" && tolower($1) == "identityfile" {
            cur_key = $2
            print cur_host "|" cur_key
            cur_host = ""
        }
    ' "$SSH_CONFIG"
}

alias_for_identity() {
    local id="$1"
    echo "${IDENTITY_PREFIX}${id}"
}

identity_for_alias() {
    local alias="$1"
    echo "${alias#${IDENTITY_PREFIX}}"
}

# `ssh -T -o ConnectTimeout=10 git@<alias>` and parse GitHub's hello reply.
# Returns the resolved GitHub username, or empty on failure.
resolve_alias() {
    local alias="$1"
    local out
    # `</dev/null` is critical: when called inside a `while read; do ssh; done`
    # loop, ssh would otherwise inherit (and slurp) the loop's stdin pipe,
    # leaving the loop with nothing to read on the next iteration.
    out=$(ssh -T -o ConnectTimeout=10 -o BatchMode=yes \
              "git@${alias}" </dev/null 2>&1 | head -1 || true)
    # "Hi <user>! You've successfully authenticated..."
    echo "$out" | sed -n 's/^Hi \([^!]*\)!.*/\1/p'
}

# Resolve owner from a git URL like:
#   git@github-myalias:myalias/digger.git    -> myalias
#   git@github.com:myalias/digger.git         -> (unsafe; warn)
#   https://github.com/myalias/digger.git     -> (https; warn)
identity_from_remote_url() {
    local url="$1"
    case "$url" in
        git@${IDENTITY_PREFIX}*:*)
            echo "${url#git@${IDENTITY_PREFIX}}" | cut -d: -f1
            ;;
        *) echo "" ;;
    esac
}

# ---- commands ---- #

cmd_doctor() {
    echo "$(c_bold ghid doctor)  ssh config: $SSH_CONFIG"
    echo
    if [[ ! -f "$SSH_CONFIG" ]]; then
        err "no SSH config file at $SSH_CONFIG"
        return 1
    fi
    local count=0
    local bare_count
    bare_count=$(awk '
        tolower($1) == "host" {
            for (i = 2; i <= NF; ++i) {
                if ($i == "github.com") { c++; break }
            }
        }
        END { print c + 0 }
    ' "$SSH_CONFIG")
    if [[ "$bare_count" -gt 1 ]]; then
        err "$bare_count blocks use bare \`Host github.com\` — only the first matches; the rest are dead."
        echo "    First-match-wins is why Sourcetree-generated configs silently auth as whichever identity sits at the top."
        echo "    Fix: rename each block to \`Host github-<identity>\` and update your remote URLs."
    elif [[ "$bare_count" -eq 1 ]]; then
        warn "one block uses bare \`Host github.com\`. If it has IdentityFile lines, plain git@github.com:... URLs will auth as that identity. Prefer aliased Hosts."
    else
        ok "no bare \`Host github.com\` blocks (good — forces explicit aliasing)"
    fi

    while IFS='|' read -r alias key; do
        [[ -z "$alias" ]] && continue
        count=$((count + 1))
        local id; id=$(identity_for_alias "$alias")
        local key_expand="${key/#\~/$HOME}"
        if [[ ! -f "$key_expand" ]]; then
            err "$alias  identity=$id  key=$key  ($(c_red missing))"
        elif [[ "$(stat -f '%Op' "$key_expand" 2>/dev/null | tail -c4)" != "600" ]]; then
            warn "$alias  identity=$id  key=$key  (perms != 0600)"
        else
            ok "$alias  identity=$id  key=$key"
        fi
    done < <(list_aliases)

    if [[ "$count" -eq 0 ]]; then
        warn "no \`Host ${IDENTITY_PREFIX}*\` aliases found. Run \`ghid new <identity>\` to add one."
    fi
}

cmd_list() {
    echo "$(c_bold Identities)"
    echo
    printf "  %-22s  %-32s  %-22s  %s\n" "ALIAS" "EMAIL" "KEY" "GITHUB RESOLVES TO"
    while IFS='|' read -r alias key; do
        [[ -z "$alias" ]] && continue
        local id; id=$(identity_for_alias "$alias")
        local email; email=$(_identity_email "$id")
        [[ -z "$email" ]] && email="$(c_dim '(unset; ghid init needs --email)')"
        local resolved
        resolved=$(resolve_alias "$alias")
        if [[ -z "$resolved" ]]; then
            resolved="$(c_red unreachable / no key registered)"
        elif [[ "$resolved" == "$id" ]]; then
            resolved="$(c_grn "$resolved")  ✓"
        else
            resolved="$(c_red "$resolved")  $(c_red MISMATCH)"
        fi
        printf "  %-22s  %-32s  %-22s  %s\n" "$alias" "$email" "$key" "$resolved"
    done < <(list_aliases)
}

cmd_current() {
    in_git_repo || die "not inside a git repo"
    local url
    url=$(git remote get-url origin 2>/dev/null || echo "")
    if [[ -z "$url" ]]; then
        warn "this repo has no \`origin\` remote"
        return 0
    fi
    echo "  origin url:  $url"
    local id
    id=$(identity_from_remote_url "$url")
    if [[ -n "$id" ]]; then
        ok "bound to identity: $(c_bold "$id")  (alias github-$id)"
    else
        warn "origin URL is NOT identity-aliased — pushes will use whichever \`Host github.com\` block matches first in ~/.ssh/config (likely wrong)."
        echo "    Fix:  ghid switch <identity>"
    fi
    if [[ -f "$(git rev-parse --git-dir)/hooks/pre-push" ]]; then
        local locked
        locked=$(grep -E '^# GHID_LOCK=' "$(git rev-parse --git-dir)/hooks/pre-push" 2>/dev/null | head -1 | cut -d= -f2)
        if [[ -n "$locked" ]]; then
            ok "lock:  this repo is locked to identity $(c_bold "$locked")"
        fi
    fi
}

cmd_init() {
    local id="${1:-}"
    [[ -z "$id" ]] && die "usage: ghid init <identity> [--email <addr>]
ghid init creates a fresh git repo here, bound to <identity>:
  - per-repo user.name / user.email (never touches ~/.gitconfig)
  - credential.helper disabled for this repo (HTTPS leak prevention)
  - pre-installed lock hook (push refused unless URL uses github-<id>)

Email lookup order:
  1. --email <addr> flag
  2. \$HOME/.config/ghidbar/identities.conf  (one line per identity)
     format: <identity>=<email>
     example: pq-cybarg=resistant@tuta.com"
    shift || true

    local email=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --email) email="${2:-}"; shift 2 ;;
            *) die "unknown arg: $1" ;;
        esac
    done

    in_git_repo && die "already a git repo here. Use \`ghid switch $id\` to bind the existing repo."

    local alias; alias=$(alias_for_identity "$id")
    grep -qE "^Host[[:space:]]+$alias\\b" "$SSH_CONFIG" \
        || die "no \`Host $alias\` in $SSH_CONFIG. Run \`ghid new $id\` first."

    [[ -z "$email" ]] && email=$(_identity_email "$id")
    if [[ -z "$email" ]]; then
        die "no email known for identity '$id'.
Pass --email <addr>, or add to $IDENTITIES_CONF:
    $id=<your-email-for-this-identity>
Or re-run \`ghid new $id\` and supply --email there so it's recorded once."
    fi

    git init -b main >/dev/null 2>&1 || git init >/dev/null
    ok "git init"

    git config --local user.name "$id"
    git config --local user.email "$email"
    git config --local credential.helper ""
    ok "user.name  = $(c_bold "$id")  (local-only)"
    ok "user.email = $(c_bold "$email")  (local-only — \$HOME/.gitconfig untouched)"
    ok "credential.helper disabled for this repo"

    # Lock hook — same shape as cmd_lock's, simplified (no unified-hook branch).
    git config --local ghid.lock-identity "$id"
    local hook_dir; hook_dir="$(git rev-parse --git-dir)/hooks"
    local hook="$hook_dir/pre-push"
    mkdir -p "$hook_dir"
    cat > "$hook" <<HOOK
#!/usr/bin/env bash
# GHID_LOCK=$id
# Pre-locked at \`ghid init\` time. Refuses pushes whose remote URL
# isn't routed through git@$alias:... Unlock with: ghid unlock
set -euo pipefail
remote_url=\$(git remote get-url "\$1" 2>/dev/null || echo "")
case "\$remote_url" in
  git@${alias}:*) exit 0 ;;
  *)
    echo "" >&2
    echo "  ✗ ghid: push refused — this repo is locked to '$id' but the" >&2
    echo "    push target is: \$remote_url" >&2
    echo "    If you meant to switch identity, run:  ghid switch <id>" >&2
    exit 1
    ;;
esac
HOOK
    chmod +x "$hook"
    ok "pre-locked to $(c_bold "$id") (pre-push hook installed)"

    _update_ghidbar_state

    echo
    echo "  Next:  git remote add origin git@${alias}:${id}/<repo>.git"
    echo "         touch README.md && git add . && git commit -m 'first commit'"
}

cmd_switch() {
    local id="${1:-}"
    [[ -z "$id" ]] && die "usage: ghid switch <identity>"
    in_git_repo || die "not inside a git repo"
    local alias; alias=$(alias_for_identity "$id")
    grep -qE "^Host[[:space:]]+$alias\\b" "$SSH_CONFIG" \
        || die "no \`Host $alias\` in $SSH_CONFIG. Run \`ghid new $id\` to add one."

    git remote | while read -r remote; do
        local url; url=$(git remote get-url "$remote")
        local new_url
        case "$url" in
            git@github-*:*)
                new_url="git@${alias}:${url#git@*:}"
                ;;
            git@github.com:*)
                new_url="git@${alias}:${url#git@github.com:}"
                ;;
            https://github.com/*)
                local path="${url#https://github.com/}"
                new_url="git@${alias}:${path%.git}.git"
                ;;
            *)
                warn "remote $remote URL not recognized as GitHub: $url"
                continue
                ;;
        esac
        git remote set-url "$remote" "$new_url"
        ok "remote $remote  ->  $new_url"
    done

    # Also kill any credential helper for this repo so HTTPS fallback
    # can't auto-auth as the wrong identity from the system keychain.
    git config --local credential.helper ""
    ok "credential.helper disabled for this repo (HTTPS leak prevention)"

    _update_ghidbar_state
}

cmd_lock() {
    local id="${1:-}"
    [[ -z "$id" ]] && die "usage: ghid lock <identity>"
    in_git_repo || die "not inside a git repo"

    # Always set the git config flag. The unified install-hooks.sh
    # pre-push hook (and digger's auto-sync hook) read this.
    git config --local ghid.lock-identity "$id"
    ok "git config ghid.lock-identity = $(c_bold "$id")"

    local hook_dir; hook_dir="$(git rev-parse --git-dir)/hooks"
    local hook="$hook_dir/pre-push"
    mkdir -p "$hook_dir"

    # If a unified pre-push hook is already installed, leave it alone —
    # it already reads ghid.lock-identity above.
    if [[ -f "$hook" ]] && grep -q "^# GHID_AUTOSYNC_HOOK_V1" "$hook"; then
        ok "unified pre-push hook detected — it will honor the lock automatically"
        return 0
    fi

    cat > "$hook" <<HOOK
#!/usr/bin/env bash
# GHID_LOCK=$id
# This repo is locked to GitHub identity '$id' by ghid. Any attempt to
# push using a different identity will be refused. Unlock with:
#   ghid unlock
set -euo pipefail
remote_url=\$(git remote get-url "\$1" 2>/dev/null || echo "")
case "\$remote_url" in
  git@github-$id:*) exit 0 ;;
  *)
    echo "" >&2
    echo "  ✗ ghid: push refused — this repo is locked to identity '$id' but the" >&2
    echo "    push target is: \$remote_url" >&2
    echo "    If you meant to push, run:  ghid switch $id" >&2
    echo "    To remove the lock entirely:  ghid unlock" >&2
    exit 1
    ;;
esac
HOOK
    chmod +x "$hook"
    ok "locked to identity $(c_bold "$id")  (pre-push hook installed)"

    _update_ghidbar_state
}

cmd_unlock() {
    in_git_repo || die "not inside a git repo"

    git config --local --unset ghid.lock-identity 2>/dev/null || true

    local hook="$(git rev-parse --git-dir)/hooks/pre-push"
    if [[ -f "$hook" ]] && grep -q "^# GHID_LOCK=" "$hook"; then
        rm "$hook"
        ok "lock removed (hook deleted, config flag cleared)"
    elif [[ -f "$hook" ]] && grep -q "^# GHID_AUTOSYNC_HOOK_V1" "$hook"; then
        ok "lock config flag cleared (unified hook remains for gh-pages auto-sync)"
    else
        warn "no ghid lock in place (config flag cleared if any)"
    fi

    _update_ghidbar_state
}

cmd_verify() {
    local id="${1:-}"
    if [[ -z "$id" ]]; then
        in_git_repo || die "usage: ghid verify <identity>   (or run inside a git repo)"
        local url; url=$(git remote get-url origin 2>/dev/null || echo "")
        id=$(identity_from_remote_url "$url")
        [[ -z "$id" ]] && die "origin URL is not identity-aliased; run \`ghid switch <id>\` first"
    fi
    local alias; alias=$(alias_for_identity "$id")
    local resolved; resolved=$(resolve_alias "$alias")
    if [[ -z "$resolved" ]]; then
        err "ssh -T git@$alias failed (no shell-Hi reply). Check the key is registered to the $id GitHub account."
        return 1
    elif [[ "$resolved" == "$id" ]]; then
        ok "alias $alias resolves to GitHub user $(c_grn "$resolved")"
    else
        err "alias $alias resolves to GitHub user $(c_red "$resolved") (expected $id) — KEY IS REGISTERED TO THE WRONG ACCOUNT"
        return 1
    fi
}

cmd_whoami() {
    in_git_repo || die "not inside a git repo"
    cmd_current
    echo
    local url; url=$(git remote get-url origin 2>/dev/null || echo "")
    local id; id=$(identity_from_remote_url "$url")
    if [[ -n "$id" ]]; then
        cmd_verify "$id"
    fi
}

cmd_new() {
    local id="${1:-}"
    [[ -z "$id" ]] && die "usage: ghid new <identity> [--email <addr>]
The email is recorded in $IDENTITIES_CONF so future
\`ghid init <identity>\` calls can find it automatically."
    shift || true
    local email=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --email) email="${2:-}"; shift 2 ;;
            *) die "unknown arg: $1" ;;
        esac
    done

    local alias; alias=$(alias_for_identity "$id")
    local key="$HOME/.ssh/${id}-GitHub"

    # Email: --email > existing identities.conf entry > interactive prompt.
    if [[ -z "$email" ]]; then
        email=$(_identity_email "$id")
    fi
    if [[ -z "$email" ]]; then
        if [[ -t 0 ]]; then
            printf "  email to record for identity '%s' (used by 'ghid init'): " "$id" >&2
            read -r email
        fi
    fi
    if [[ -n "$email" ]]; then
        _identity_email_set "$id" "$email"
        ok "recorded $id=$email in $IDENTITIES_CONF"
    else
        warn "no email recorded for $id; \`ghid init $id\` will prompt or require --email."
    fi

    if grep -qE "^Host[[:space:]]+$alias\\b" "$SSH_CONFIG" 2>/dev/null; then
        warn "alias $alias already exists in $SSH_CONFIG — skipping config append"
    else
        if [[ -f "$key" ]]; then
            ok "reusing existing key $key (no regeneration)"
        else
            echo "  generating ed25519 key at $key"
            ssh-keygen -t ed25519 -f "$key" -C "${id}@isolated"
        fi
        cat >> "$SSH_CONFIG" <<CFG

Host $alias
    HostName github.com
    User git
    IdentityFile $key
    IdentitiesOnly yes
    UseKeychain yes
    AddKeysToAgent yes
CFG
        ok "added $alias to $SSH_CONFIG"
    fi

    # Smart: check whether GitHub ALREADY accepts this key for $id.
    # If it does, the user is done — no need to re-register.
    echo
    echo "checking whether GitHub already accepts this key as $id ..."
    local resolved; resolved=$(resolve_alias "$alias")
    if [[ "$resolved" == "$id" ]]; then
        ok "GitHub already recognizes this key as $(c_grn "$id") — no registration needed"
        return 0
    elif [[ -n "$resolved" ]]; then
        err "GitHub recognizes this key as $(c_red "$resolved"), not $id."
        echo "    Either this key is registered to the wrong account,"
        echo "    or deregister it from $resolved and register on $id."
        echo "    Public key:"
        echo
        cat "${key}.pub"
        return 1
    fi
    warn "GitHub does not yet recognize this key. To register:"
    echo "    1. In a fresh private/incognito browser window, log in as $id"
    echo "    2. Open https://github.com/settings/ssh/new"
    echo "    3. Paste the public key below"
    echo
    cat "${key}.pub"
    echo
    echo "Then verify with:  ghid verify $id"
}

# Generate a fresh key, archive the old one, update SSH config to point
# at the new key. Then walk through registering new + revoking old on
# GitHub. Cannot use GitHub's API automatically because identity
# isolation forbids using one account's PAT to manipulate another's
# keys; the rotation is operator-driven but ghid handles all the file
# choreography.
cmd_rotate() {
    local id="${1:-}"
    [[ -z "$id" ]] && die "usage: ghid rotate <identity>"
    local alias; alias=$(alias_for_identity "$id")
    local key="$HOME/.ssh/${id}-GitHub"
    local archive_dir="$HOME/.ssh/.ghid-archive"
    local ts; ts=$(date +%Y%m%d-%H%M%S)

    grep -qE "^Host[[:space:]]+$alias\\b" "$SSH_CONFIG" 2>/dev/null \
        || die "no alias $alias in $SSH_CONFIG. Run \`ghid new $id\` first."

    local old_fp=""
    if [[ -f "$key" ]]; then
        mkdir -p "$archive_dir"
        chmod 700 "$archive_dir"
        cp "$key" "$archive_dir/${id}-GitHub.${ts}.old"
        cp "${key}.pub" "$archive_dir/${id}-GitHub.${ts}.old.pub"
        old_fp=$(ssh-keygen -lf "${key}.pub" 2>/dev/null)
        ok "archived old key to $archive_dir/${id}-GitHub.${ts}.old{,.pub}"
        rm "$key" "${key}.pub"
    else
        warn "no existing key at $key — nothing to archive; treating as fresh."
    fi

    echo "  generating fresh ed25519 key at $key"
    ssh-keygen -t ed25519 -f "$key" -C "${id}@isolated-rotated-${ts}"
    ok "new key generated"

    echo
    echo "--- next steps ---"
    echo "  1. New public key (paste at github.com/settings/ssh/new):"
    echo
    cat "${key}.pub"
    echo
    echo "  2. In a fresh private/incognito browser, log in as $id and:"
    echo "      a. https://github.com/settings/ssh/new   ← add the new key"
    echo "      b. https://github.com/settings/keys       ← delete the OLD key"
    [[ -n "$old_fp" ]] && echo "         (old fingerprint to delete: $old_fp)"
    echo
    echo "  3. Verify the new key works:"
    echo "      ghid verify $id"
    echo
    [[ -d "$archive_dir" ]] && \
        echo "Old key archived (revertable):  $archive_dir/${id}-GitHub.${ts}.old{,.pub}"
}

# Machine-wide new-repo guard.
#
# `ghid <subcmd>` is per-repo and opt-in — you have to remember to run
# `ghid init`. The guard is the backstop for when you forget: a global git
# `init.templateDir` pre-commit hook that git copies into EVERY new repo, so a
# brand-new `git init`/`git clone` can never silently inherit your global
# identity. The hook refuses to commit until the repo has an explicit LOCAL
# user.email (set by `ghid init` or by hand). Works in every terminal because
# it's enforced by git itself, not by shell state.
GUARD_MARKER="GHID_GUARD_V1"
GUARD_TEMPLATE_DEFAULT="$HOME/.config/git/ghid-template"

# Resolve the hooks directory the guard should live in: respect an existing
# global init.templateDir if one is set, else use our default.
_guard_target_dir() {
    local existing
    existing=$(git config --global init.templateDir 2>/dev/null || true)
    if [[ -n "$existing" ]]; then
        echo "${existing/#\~/$HOME}"
    else
        echo "$GUARD_TEMPLATE_DEFAULT"
    fi
}

# Emit the pre-commit hook body (quoted heredoc — no expansion here; all
# expansion happens when the hook itself runs).
_guard_hook_body() {
    cat <<'HOOK'
#!/usr/bin/env bash
# GHID_GUARD_V1 — installed by `ghid guard install` via git init.templateDir.
# Refuses to commit in a repo with no explicit LOCAL git identity, so a new
# repo can never silently inherit your global identity. Choose one first with
# `ghid init <id>` or `git config --local user.email/.name`.
set -euo pipefail
[[ "${GHID_GUARD_DISABLE:-0}" == "1" ]] && exit 0
local_email=$(git config --local user.email 2>/dev/null || true)
[[ -n "$local_email" ]] && exit 0   # explicit per-repo identity chosen — allow
global_email=$(git config user.email 2>/dev/null || echo "?")
{
  echo ""
  echo "  ✗ ghid-guard: this repo has no explicit (local) git identity."
  echo "    A commit here would inherit your GLOBAL identity:  $global_email"
  echo "    Pick an identity first (prevents opsec leaks):"
  echo "      ghid init <identity>                 # brand-new repo, bound + locked"
  echo "      git config --local user.name  <name>"
  echo "      git config --local user.email <addr>"
  if [[ -f "$HOME/.config/ghidbar/identities.conf" ]]; then
    echo "    Known ghid identities (id=email):"
    grep -vE '^[[:space:]]*#' "$HOME/.config/ghidbar/identities.conf" | sed 's/^/      /'
  fi
  echo "    Bypass once (deliberate):  GHID_GUARD_DISABLE=1 git commit ..."
  echo ""
} >&2
exit 1
HOOK
}

cmd_guard() {
    local action="${1:-status}"
    case "$action" in
        install)   _guard_install ;;
        status)    _guard_status ;;
        uninstall) _guard_uninstall ;;
        *) die "usage: ghid guard {install|status|uninstall}" ;;
    esac
}

_guard_install() {
    local existing dir hook
    existing=$(git config --global init.templateDir 2>/dev/null || true)
    dir=$(_guard_target_dir)
    hook="$dir/hooks/pre-commit"
    mkdir -p "$dir/hooks"

    if [[ -f "$hook" ]] && ! grep -q "$GUARD_MARKER" "$hook"; then
        die "a non-ghid pre-commit hook already exists at $hook — refusing to overwrite. Inspect/merge it by hand."
    fi

    _guard_hook_body > "$hook"
    chmod +x "$hook"
    ok "guard hook installed at $hook"

    if [[ -z "$existing" ]]; then
        git config --global init.templateDir "$dir"
        ok "git config --global init.templateDir = $(c_bold "$dir")"
    elif [[ "${existing/#\~/$HOME}" == "$dir" ]]; then
        ok "init.templateDir already = $existing"
    else
        ok "merged guard into your existing init.templateDir ($existing)"
    fi
    echo "  Every new \`git init\`/\`git clone\` now refuses commits until an identity is set."
    echo "  Existing repos are untouched. Disable: ghid guard uninstall"
}

_guard_status() {
    local td hook
    td=$(git config --global init.templateDir 2>/dev/null || true)
    if [[ -z "$td" ]]; then
        warn "no global init.templateDir set — guard is NOT active. Enable: ghid guard install"
        return 0
    fi
    echo "  init.templateDir: $td"
    hook="${td/#\~/$HOME}/hooks/pre-commit"
    if [[ -f "$hook" ]] && grep -q "$GUARD_MARKER" "$hook"; then
        ok "ghid-guard active — new repos require an explicit local identity"
    else
        warn "init.templateDir is set but no ghid-guard hook at $hook"
    fi
}

_guard_uninstall() {
    local td dir hook
    td=$(git config --global init.templateDir 2>/dev/null || true)
    if [[ -z "$td" ]]; then
        warn "no init.templateDir set — nothing to uninstall"
        return 0
    fi
    dir="${td/#\~/$HOME}"
    hook="$dir/hooks/pre-commit"
    if [[ -f "$hook" ]] && grep -q "$GUARD_MARKER" "$hook"; then
        rm "$hook"
        ok "removed guard hook $hook"
    else
        warn "no ghid-guard hook at $hook (left other files alone)"
    fi
    # Only tear down config + dir if this is the dir we created.
    if [[ "$dir" == "$GUARD_TEMPLATE_DEFAULT" ]]; then
        rmdir "$dir/hooks" "$dir" 2>/dev/null || true
        git config --global --unset init.templateDir 2>/dev/null || true
        ok "unset global init.templateDir"
    else
        warn "left init.templateDir = $td in place (not created by ghid)"
    fi
}

# ---- dispatch ---- #

cmd="${1:-doctor}"
shift 2>/dev/null || true
case "$cmd" in
    list)     cmd_list ;;
    doctor)   cmd_doctor ;;
    current)  cmd_current ;;
    init)     cmd_init "$@" ;;
    switch)   cmd_switch "$@" ;;
    lock)     cmd_lock "$@" ;;
    unlock)   cmd_unlock ;;
    guard)    cmd_guard "$@" ;;
    verify)   cmd_verify "$@" ;;
    whoami)   cmd_whoami ;;
    new)      cmd_new "$@" ;;
    -h|--help|help)
        sed -n '4,38p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *) die "unknown subcommand: $cmd (try: ghid help)" ;;
esac
